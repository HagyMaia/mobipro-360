{
  "name": "SR Logística - App do Motorista",
  "short_name": "SR Motorista",
  "description": "Aplicativo oficial para motoristas e parceiros da SR Logística. Gerenciamento de corridas, despacho e repasses em tempo real.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/",
    "use_cache": true
  },
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "fullscreen"
  ],
  "orientation": "portrait",
  "background_color": "#070D18",
  "theme_color": "#070D18",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": [
    "transportation",
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Central Oficial do Motorista - SR Logística"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Painel Operacional SR Logística"
    }
  ],
  "shortcuts": [
    {
      "name": "Minhas Corridas",
      "short_name": "Corridas",
      "description": "Acessar histórico e chamadas de corridas",
      "url": "/corridas",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Meus Ganhos",
      "short_name": "Ganhos",
      "description": "Ver faturamento, saldo e repasses via PIX",
      "url": "/financeiro",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
